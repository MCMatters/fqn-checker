#!/usr/bin/env php
<?php

use McMatters\FqnChecker\Console\Command\RunCommand;
use Symfony\Component\Console\Application;
use Symfony\Component\Console\Input\ArrayInput;
use Symfony\Component\Console\Output\ConsoleOutput;

if ($argc !== 2) {
    fwrite(STDERR, 'Missed "path" argument'.PHP_EOL);

    exit(1);
}

$cwd = getcwd();

$autoloadPaths = [
    "{$cwd}/vendor/autoload.php",
    "{$cwd}/../../autoload.php",
    __DIR__.'/../vendor/autoload.php',
    __DIR__.'/../../../autoload.php',
];

$autoloadExists = false;

foreach ($autoloadPaths as $path) {
    if (file_exists($path)) {
        require_once $path;
        $autoloadExists = true;
    }
}

if (!$autoloadExists) {
    fwrite(
        STDERR,
        'Can not load autoload.php file. Maybe you missed run "composer install"?'.PHP_EOL
    );

    exit(1);
}

$app = new Application();

if (method_exists($app, 'addCommand')) {
    $app->addCommand(new RunCommand());
} elseif (method_exists($app, 'add')) {
    $app->add(new RunCommand());
} else {
    throw new RuntimeException('Unsupported application version');
}

$input = new ArrayInput([
    'command' => 'fqn-checker:check',
    'path' => $argv[1],
]);

$output = new ConsoleOutput();

$app->run($input, $output);
